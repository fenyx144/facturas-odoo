<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_import" model="ir.ui.view">
        <field name="name">account.move.form.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Observada" bg_color="text-bg-warning"
                        invisible="validation_state != 'observada'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Importación" name="importacion" invisible="import_source != 'n8n'">
                    <group>
                        <group>
                            <field name="import_source"/>
                            <field name="import_channel"/>
                            <field name="import_sender" invisible="not import_sender"/>
                            <field name="import_execution"/>
                        </group>
                        <group>
                            <field name="validation_state" widget="badge"
                                   decoration-success="validation_state == 'ok'"
                                   decoration-warning="validation_state == 'observada'"/>
                            <field name="validation_notes" invisible="not validation_notes"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_import" model="ir.ui.view">
        <field name="name">account.move.list.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="validation_state" widget="badge" optional="show"
                       decoration-success="validation_state == 'ok'"
                       decoration-warning="validation_state == 'observada'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_import" model="ir.ui.view">
        <field name="name">account.move.search.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="before">
                <filter string="Importadas" name="importadas" domain="[('import_source', '=', 'n8n')]"/>
                <filter string="Observadas" name="observadas" domain="[('validation_state', '=', 'observada')]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Validación" name="group_validation" context="{'group_by': 'validation_state'}"/>
            </xpath>
        </field>
    </record>
</odoo>
